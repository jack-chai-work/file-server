{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻型文件服务器",
  "version": "0.1.0",
  "identifier": "com.local.tauri-ftp-server",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻型文件服务器",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/32.png",
      "icons/128.png",
      "icons/128@2x.png",
      "icons/icon.png"
    ]
  }
}
